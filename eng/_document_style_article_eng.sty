\usepackage{tcolorbox}% Per creare box colorati (es. per teoremi, esempi, ecc.)
\tcbuselibrary{breakable, skins} % Per box che possono andare su più pagine e con stili personalizzati

% Definiamo uno stile globale per comodità
\tcbset{
    enhanced jigsaw,             % Skin raccomandata per box spezzati
    colback=red!5!white,         % Colore di sfondo
    colframe=red!75!black,       % Colore della cornice
    fonttitle=\bfseries,         % Grassetto per il titolo
    %watermark color=yellow!25!white, 
    %watermark text=\arabic{tcbbreakpart} % Filigrana con il numero della parte
}

% Comando personalizzato per box di approfondimento con numerazione automatica
\newtcolorbox[use counter*=section]{myBoxInsight}[2][]{
    breakable,
    enhanced jigsaw,
    colback=black!5!white,
    colframe=black!75!white,
    fonttitle=\relsize{1}\bfseries,
    title=\thetcbcounter~Approfondimento -- #2,
    add to list={toc}{section}, % <--- Invia la voce al \tableofcontents
    list text={Approfondimento -- #2},                % <--- Testo da mostrare nell'indice
    leftrule=0pt,
    rightrule=0pt,
    sharp corners,
    toptitle=3mm,    % <--- Aumenta lo spazio sopra il testo del titolo
    bottomtitle=3mm, % <--- Aumenta lo spazio sotto il testo del titolo
    phantom=\phantomsection, % <--- ANCORAGGIO PER I LINK
    #1
}

% Comando intelligente per costanti matematiche
\ExplSyntaxOn
\NewDocumentCommand{\upconst}{m}
 {
  % Controlla se il numero di caratteri dell'input (#1) è esattamente 1
  \int_compare:nNnTF { \str_count:n { #1 } } = { 1 }
   { \mathrm { #1 } }    % [Vero] 1 carattere: applica \mathrm
   { \use:c { up #1 } }  % [Falso] >1 caratteri: equivalente a \csname up#1\endcsname
 }
\ExplSyntaxOff

