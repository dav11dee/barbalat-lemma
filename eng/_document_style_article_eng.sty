% --- NOTAZIONI MATRICIALI ---

% Cofattore di una matrice (con i,j come indici)
\newcommand{\cof}[3]{\Cof_{#1,#2}\mleft( #3 \mright)}

% 1. Elemento di posto i,j (Opzionale: potresti anche scriverlo a mano essendo molto semplice)
% Uso: \entry{A}{ij} oppure \entry{A}{i,j}
% \newcommand{\entry}[2]{#1_{#2}}

% 2. Riga di una matrice
% Uso: \matrow{\matr{A}}{i}
\newcommand{\matrow}[2]{{#1}_{(#2)}}

% 3. Colonna di una matrice
% Uso: \matcol{\matr{A}}{j}
\newcommand{\matcol}[2]{{#1}^{(#2)}}
% 4. Sottomatrice generale (estrazione di righe I e colonne J)
% Uso: \submat{\matr{A}}{I}{J}
% Uso: \submat{\matr{A}}{i_1,i_2,...,i_k}{j_1,j_2,...,j_l}
\newcommand{\submat}[3]{{#1}_{(#2)}^{(#3)}}

% 5. Sottomatrice con riga i e colonna j eliminate (taglio)
% Uso: \subdel{\matr{A}}{i}{j}
\newcommand{\subdel}[3]{{#1}_{(#2 \mid #3)}}

\newcommand{\matrowsysm}[1]{\mathscr{R}_{#1}} % Simbolo per il sistema di righe di una matrice
\newcommand{\matcolsysm}[1]{\mathscr{\altC}_{#1}} % Simbolo per il sistema di colonne di una matrice
